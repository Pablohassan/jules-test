{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --dts --clean --external bullmq --external ioredis --external @bull-board/api --external @bull-board/express --external zod --external @prisma/client",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@bull-board/api": "^5.19.1",
    "@bull-board/express": "^5.19.1",
    "@mozilla/readability": "^0.5.0",
    "bullmq": "^5.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.0.0-beta.2",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsdom": "^24.1.0",
    "nodemailer": "^6.9.14",
    "puppeteer": "^23.7.1",
    "openai": "^4.52.7",
    "pino-http": "^9.0.0",
    "redis": "^4.6.15",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/turndown": "^5.0.4",
    "tsup": "^8.2.2",
    "tsx": "^4.16.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.3"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  }
}
