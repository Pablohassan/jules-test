DATABASE_URL="postgresql://user:password@localhost:5432/veille"
REDIS_URL="redis://localhost:6379"
WEB_ORIGIN="http://localhost:5173"

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- External Services ---
TAVILY_API_KEY="your-tavily-api-key"
OPENAI_API_KEY="your-openai-api-key"
GAMMA_API_KEY="your-gamma-api-key"
GAMMA_API_BASE="https://api.gamma.app"
GAMMA_API_VERSION="v1"
GAMMA_API_AUTH_STYLE="bearer" # or "x-api-key"
# v1 generate path and default exports
GAMMA_API_GENERATE_PATH="/generate"
GAMMA_EXPORTS="pdf,pptx"
GMAIL_SENDER="your-email@gmail.com"
DRIVE_FOLDER_ID="your-google-drive-folder-id"
OPENAI_MODEL="gpt-5-mini"
OPENAI_MAX_CHARS=60000
OPENAI_RETRY_ATTEMPTS=3
OPENAI_RETRY_BASE_MS=750
OPENAI_SUMMARY_CONCURRENCY=1
OPENAI_SUMMARY_BASE_DELAY_MS=300
JINA_API_URL="https://r.jina.ai/" # or a private endpoint, e.g. https://api.jina.ai/read
JINA_API_KEY="" # optional bearer token if your Jina endpoint requires it
GAMMA_EXPORT_MAX_WAIT_MS=180000
GAMMA_EXPORT_POLL_MS=3000
GAMMA_DISTRIBUTION_MAX_ATTEMPTS=5
GAMMA_DISTRIBUTION_BASE_DELAY_MS=60000
